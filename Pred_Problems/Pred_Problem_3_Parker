# ============================================
# Problem 3 — Multi-class congestion risk tiering
# ============================================

# 1. Imports
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.metrics import ConfusionMatrixDisplay, confusion_matrix
from sklearn.model_selection import train_test_split
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import StandardScaler

from sklearn.tree import DecisionTreeClassifier
from sklearn.ensemble import RandomForestClassifier

from sklearn.metrics import accuracy_score, classification_report

# 2. Load data
# (Update the path if your CSV is in a different location)
csv_path = "../data/feeder_features_cleaned.csv"
df = pd.read_csv(csv_path)

print("Data shape:", df.shape)
df.head()

# 3. Build features X and multi-class target y_tier

response_col = "mean_ica_sg"

# Drop rows with missing response
df = df.dropna(subset=[response_col])

# Use only numeric columns as features (exclude response column)
numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()
feature_cols = [c for c in numeric_cols if c != response_col]

X = df[feature_cols]
headroom = df[response_col]

# Define 3 congestion risk tiers based on min_ica_of (headroom, in MW):
#   0 = low risk    (min_ica_of > 5000.0)
#   1 = medium risk (1000.0 <= min_ica_of <= 5000.0)
#   2 = high risk   (min_ica_of < 1000.0)
conditions = [
    headroom > 5000.0,
    (headroom >= 1000.0) & (headroom <= 5000.0),
    headroom < 1000.0
]
choices = [0, 1, 2]

y_tier = np.select(conditions, choices).astype(int)

print("Number of feature columns:", len(feature_cols))
print("Tier distribution:")
print(pd.Series(y_tier).value_counts().sort_index())

# 4. Train/test split

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y_tier,
    test_size=0.2,
    random_state=42,
    stratify=y_tier
)

# 5. Helper: print multi-class metrics

def print_multiclass_metrics(y_true, y_pred, label=""):
    acc = accuracy_score(y_true, y_pred)
    print(f"\n=== {label} ===")
    print(f"Accuracy: {acc:.3f}")
    print("Classification report:")
    print(classification_report(y_true, y_pred))

# 6. Fit and evaluate models

# (a) Decision Tree
dt_model = make_pipeline(
    StandardScaler(),
    DecisionTreeClassifier(
        max_depth=5,
        min_samples_leaf=50,
        random_state=42
    )
)
dt_model.fit(X_train, y_train)
y_pred_dt = dt_model.predict(X_test)
print_multiclass_metrics(y_test, y_pred_dt, label="Decision Tree (3-tier)")

# ============================================
# DT confusion matrix
# ============================================

dt_labels = ["Low risk (0)", "Med risk (1)", "High risk (2)"]

cm_dt = confusion_matrix(y_test, y_pred_dt, labels=[0, 1, 2])
disp_dt = ConfusionMatrixDisplay(confusion_matrix=cm_dt,
                                 display_labels=dt_labels)

plt.figure(figsize=(6, 5))
disp_dt.plot(cmap="Reds", values_format="d")
plt.title("Decision Tree — Test Set Tier Categorization")
plt.xlabel("Predicted Tier")
plt.ylabel("True Tier")
plt.tight_layout()
plt.show()


# (b) Random Forest
rf_model = make_pipeline(
    StandardScaler(),
    RandomForestClassifier(
        n_estimators=200,
        random_state=42,
        n_jobs=-1
    )
)
rf_model.fit(X_train, y_train)
y_pred_rf = rf_model.predict(X_test)
print_multiclass_metrics(y_test, y_pred_rf, label="Random Forest (3-tier)")

y_pred_rf = rf_model.predict(X_test)

# ============================================
# 7. Visualization — Confusion Matrix (Random Forest)
# ============================================

tier_labels = ["Low risk (0)", "Med risk (1)", "High risk (2)"]

cm = confusion_matrix(y_test, y_pred_rf, labels=[0, 1, 2])
disp = ConfusionMatrixDisplay(confusion_matrix=cm,
                              display_labels=tier_labels)

plt.figure(figsize=(6, 5))
disp.plot(cmap="Blues", values_format="d")
plt.title("Random Forest — Test Set Tier Categorization")
plt.xlabel("Predicted Tier")
plt.ylabel("True Tier")
plt.tight_layout()
plt.show()
